TELEGRAM_BOT_TOKEN=your_bot_token
# Office / lead alerts (forms, Meta, Google). Per-tech job alerts use Employees → Telegram chat id.
TELEGRAM_CHAT_ID=your_chat_id

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+19495551234
NOTIFY_PHONE_NUMBER=+19495390009

# AI Council — leads, SEO snapshots, website AI chat (/api/ai-chat)
AI_COUNCIL_BASE_URL=https://aicouncil-offsams-projects.vercel.app
GARAGE_GUYS_LEAD_WEBHOOK_SECRET=your_shared_webhook_secret

# Google Analytics 4 (client-side tag via /api/analytics.js)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console + GA4 Data API (server-side daily sync)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GSC_SITE_URL=sc-domain:garageguysoc.com
GA4_PROPERTY_ID=123456789
SEO_SYNC_DAYS=28

# Protect /api/seo-sync, /api/ads-sync, /api/google-reviews-sync manual runs
CRON_SECRET=your_random_cron_secret

# Meta Ads (Marketing API — metrics + Lead Ads webhook)
META_AD_ACCOUNT_ID=act_XXXXXXXX
META_ADS_ACCESS_TOKEN=EAAB...
META_APP_SECRET=your_app_secret
META_WEBHOOK_VERIFY_TOKEN=pick_a_random_string
META_PAGE_ID=optional_page_id
# Google Cloud API key (Ads + Local Services + My Business on one key)
GOOGLE_CLOUD_API_KEY=AIza...
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=https://garageguysoc.com/api/auth/google-ads/callback
GOOGLE_ADS_LEAD_WEBHOOK_KEY=pick_a_random_string
# Required (fail-closed). Lead form webhook POST google_key must match this value.
# Lead form webhook: https://garageguysoc.com/api/ads/google-leads
# Connect OAuth: https://garageguysoc.com/api/auth/google-ads

# Google reviews sync (Places API — rating/count + up to 5 review texts)
GOOGLE_PLACES_API_KEY=AIza...
GOOGLE_PLACE_ID=ChIJ...

# Google Business Profile API (full reviews + owner replies) — OAuth owner account
# Reuses GOOGLE_ADS_CLIENT_ID / SECRET if GOOGLE_GBP_CLIENT_* are empty.
# In Google Cloud add redirect: https://garageguysoc.com/api/auth/google-gbp/callback
# Enable Business Profile API + Account Management + Business Information.
# Then open /api/auth/google-gbp, click Allow — the callback page prints TOKEN, ACCOUNT_ID, LOCATION_ID.
GOOGLE_GBP_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_GBP_CLIENT_SECRET=...
GOOGLE_GBP_REFRESH_TOKEN=...
GOOGLE_GBP_ACCOUNT_ID=accounts/123
GOOGLE_GBP_LOCATION_ID=locations/456
GOOGLE_GBP_REDIRECT_URI=https://garageguysoc.com/api/auth/google-gbp/callback

# Geoapify address autocomplete (Sheet / CRM / Field)
GEOAPIFY_API_KEY=your_geoapify_api_key

# IndexNow (Bing / Copilot / ChatGPT index). Key file is public/<hex>.txt — not a secret.
# Production deploys ping automatically via npm postbuild. Manual: npm run indexnow
# INDEXNOW_FORCE=1

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
